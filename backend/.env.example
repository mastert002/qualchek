# QualChek backend configuration.
#
# Copy to .env and fill in. Nothing here is carried over from the project this
# was duplicated from, deliberately - see DATABASE_URL below.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# QualChek MUST point at its own database. The project this was copied from
# shares one database between local and production, so reusing that connection
# string would write QualChek's users, projects, test cases and crawler
# credentials straight into that live application's data.
#
# Create an empty Postgres database and put its connection string here. The
# schema builds itself on first start: initDb() creates every table when it
# finds no public.users, which is exactly the case on an empty database.
DATABASE_URL=

# Signing key for access tokens. The app refuses to start without one, and
# refuses the placeholder value that used to be committed. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

PORT=3001

# false keeps the API from also serving frontend/dist, which is what you want
# in local development where Vite serves the UI on :3100.
SERVE_FRONTEND=false

# Used to build invite and password-reset links in outgoing mail.
APP_URL=http://localhost:3100

# Invite and reset mail. Without these the link is logged to the console
# instead, which is fine for development.
SMTP_USER=
SMTP_PASS=
MAIL_FROM=QualChek <no-reply@example.com>


# How long a session can live before signing in again (hours).
REFRESH_TTL_HOURS=12

# Path to Chrome for the crawler, if it is not in the default location.
# PUPPETEER_EXECUTABLE_PATH=

# ---------------------------------------------------------------------------
# TENANT ISOLATION
# ---------------------------------------------------------------------------
#
# Two roles, on purpose. A table owner bypasses row-level security, and RLS is
# what keeps one customer's data away from another - so the role serving
# requests must NOT own the tables.
#
#   DATABASE_URL            the application role (qualchek_app). Owns nothing.
#   MIGRATION_DATABASE_URL  the owner (qualchek_owner). Runs DDL only.
#
# Point both at the same role and the app still runs, but every tenant can read
# every other tenant. It warns loudly in development and refuses to start when
# hosted. See migrations/000-create-database.sql.
MIGRATION_DATABASE_URL=

# The application role's name, so migrations can grant it access to new tables.
DB_APP_ROLE=qualchek_app

# Connections held by the pool. A request checks one out for its duration.
DB_POOL_MAX=10

# Trial length for a new workspace, in days.
TRIAL_DAYS=14
